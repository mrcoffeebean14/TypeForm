# Backend configuration (copy to .env for local overrides)

# SQLite database URL. Point this at a mounted persistent disk in production,
# otherwise the DB is wiped on every redeploy. Examples:
#   Render:  sqlite:////var/data/app.db
#   Railway: sqlite:////data/app.db   (with a Volume mounted at /data)
DATABASE_URL=sqlite:///./app.db

# Comma-separated allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Public URL of the respondent app (used when composing share links).
PUBLIC_BASE_URL=http://localhost:3000
