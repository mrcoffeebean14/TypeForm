# Backend configuration (copy to .env for local overrides)

# SQLite database URL. On Render, point this at the mounted disk, e.g.
# sqlite:////var/data/app.db
DATABASE_URL=sqlite:///./app.db

# Comma-separated allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Public URL of the respondent app (used when composing share links).
PUBLIC_BASE_URL=http://localhost:3000
